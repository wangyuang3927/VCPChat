# MacTerminalExecutor 配置
# ============================================================

# 返回模式: delta(仅返回最新命令输出) / full(返回整个终端内容)
RETURN_MODE=delta

# 禁止的命令关键字 (逗号分隔，不区分大小写)
# 这些关键字出现在命令中会被直接拦截
FORBIDDEN_COMMANDS=rm -rf /,rm -rf /*,mkfs,:(){ :|:&};:

# 需要管理员验证码的命令关键字 (逗号分隔)
AUTH_REQUIRED_COMMANDS=sudo,diskutil,systemsetup,csrutil,nvram,bless
